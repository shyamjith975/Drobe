{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@drobe/api-client": ["../../packages/api-client/src"],
      "@drobe/design-tokens": ["../../packages/design-tokens/src"],
      "@drobe/shared-types": ["../../packages/shared-types/src"]
    }
  },
  "include": ["src"]
}
