# ==============================================================================
# DROBE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Backend & Database
# For SQLite local dev: sqlite:///./drobe.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/drobe_db
DATABASE_URL=sqlite:///./drobe.db
TEST_DATABASE_URL=sqlite:///./test_drobe.db

# Redis Caching & Queue
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
SECRET_KEY=drobe_ultra_secure_jwt_secret_key_change_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:19006,exp://localhost:19000

# Media Uploads & Storage
STORAGE_PROVIDER=local # local or s3
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=drobe-media-assets
CDN_BASE_URL=

# Razorpay Payment Integration (Sandbox / Production)
RAZORPAY_KEY_ID=rzp_test_drobe_fashion_2026
RAZORPAY_KEY_SECRET=drobe_sandbox_secret_987654321
RAZORPAY_WEBHOOK_SECRET=drobe_webhook_secret_key_123

# Platform Financial Settings
DEFAULT_COMMISSION_PERCENTAGE=20.0
CURRENCY=INR

# Notifications & Email/SMS (Optional / Mock)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=msg91 # msg91 or twilio
SMS_AUTH_KEY=

# Mobile App & Web URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
